{
  "name": "local-portfolio-builder",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "A secure local-first visual portfolio builder for browsers, Windows, and Android.",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"node --watch src/server/server.js\"",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "start": "node src/server/server.js",
    "app:dev": "tauri dev",
    "app:build:windows": "tauri build --bundles nsis",
    "app:init:android": "tauri android init",
    "app:build:android": "tauri android build --apk",
    "app:build:android:debug": "tauri android build --apk --debug --target aarch64 x86_64",
    "app:collect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/collect-release-artifacts.ps1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "multer": "2.4.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@tauri-apps/cli": "^2.11.5",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.4",
    "eslint": "10.11.0",
    "globals": "16.4.0",
    "postcss": "8.5.28",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "tailwindcss": "3.4.17",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
